  "fatigue_logic": {
    "description": "Research-backed coefficients for burnout risk calculation",
    "coefficients": {
      "short_rest_penalty": {
        "value": 1.94,
        "applies_when": "rest_hours < 11",
        "reference": "AML § 10-8 violation"
      },
      "backward_rotation_penalty": {
        "value": 0.49,
        "applies_when": "Night->Evening or Evening->Day transition",
        "reference": "Circadian disruption research"
      },
      "consecutive_night_penalty": {
        "value": 0.68,
        "applies_when": "Each night after the first consecutive",
        "reference": "Sleep debt accumulation"
      },
      "base_night_penalty": {
        "value": 0.22,
        "applies_when": "Any night shift",
        "reference": "Standard night work health risk"
      },
      "long_shift_penalty": {
        "value": 0.35,
        "applies_when": "shift_hours > 10",
        "reference": "Extended shift fatigue"
      },
      "quick_return_penalty": {
        "value": 0.85,
        "applies_when": "rest_hours < 9",
        "reference": "Severe rest deficit"
      },
      "weekend_work_penalty": {
        "value": 0.15,
        "applies_when": "Saturday or Sunday shift",
        "reference": "Social rhythm disruption"
      }
    },
    "risk_thresholds": {
      "low": {
        "min": 0.0,
        "max": 3.0,
        "color": "green",
        "action": "Monitor"
      },
      "medium": {
        "min": 3.1,
        "max": 6.0,
        "color": "yellow",
        "action": "Review schedule"
      },
      "high": {
        "min": 6.1,
        "max": 10.0,
        "color": "orange",
        "action": "Immediate schedule adjustment required"
      },
      "critical": {
        "min": 10.1,
        "max": 100.0,
        "color": "red",
        "action": "Mandatory intervention - AML violation likely"
      }
    },
    "calculation_period_days": 28
  },

  "validation_rules": {
    "data_quality_flags": {
      "MAPPING_REQUIRED": "Unknown shift code encountered",
      "OVERLAP_DETECTED": "Shift times overlap with another entry",
      "IMPOSSIBLE_HOURS": "Shift duration exceeds 24 hours",
      "MISSING_EMPLOYEE_ID": "Employee identifier missing",
