      "multiplier": 0.49,
      "description": "Night -> Evening or Evening -> Day rotation"
    },
    "successive_nights": {
      "multiplier": 0.68,
      "description": "Added for every night after the first"
    },
    "night_shift_base": {
      "multiplier": 0.22,
      "description": "Standard health risk for night work"
    }
