{
  "version": "2026.1",
  "effective_date": "2026-01-01",
  "jurisdiction": "NO",

  "aml": {
    "section_10_8": {
      "title": "Daglig og ukentlig arbeidsfri",
      "daily_rest": {
        "threshold_hours": 11,
        "description": "Arbeidstaker skal ha minst 11 timer sammenhengende arbeidsfri i loepet av 24 timer",
        "reference": "AML ss 10-8 (1)"
      },
      "weekly_rest": {
        "threshold_hours": 35,
        "window_hours": 168,
        "description": "Arbeidstaker skal ha en sammenhengende arbeidsfri periode paa 35 timer i loepet av sju dager",
        "reference": "AML ss 10-8 (2)"
      },
      "reduced_rest": {
        "minimum_hours": 8,
        "requires_compensatory": true,
        "description": "Kan reduseres til 8 timer ved skriftlig avtale, men krever kompenserende hvile",
        "reference": "AML ss 10-8 (3)"
      },
      "sunday_rule": {
        "max_consecutive": 3,
        "description": "Arbeidstaker skal ha fri minst annenhver sondag",
        "reference": "AML ss 10-8 (4)"
      }
    },
    "section_4_3": {
      "title": "Krav til det psykososiale arbeidsmiljoet",
      "description": "Arbeidet skal legges til rette slik at arbeidstakers integritet og verdighet ivaretas",
      "reference": "AML ss 4-3"
    }
  },

  "hta": {
    "version": "2024-2026",
    "weekly_hours": {
      "standard": 35.5,
      "night_shift": 33.6,
      "rotating_shift": 35.5
    },
    "overtime": {
      "max_daily": 2,
      "max_weekly": 10,
      "max_monthly": 25,
      "max_yearly": 200
    }
  },

